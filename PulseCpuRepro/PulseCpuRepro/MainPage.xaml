<Page x:Class="PulseCpuRepro.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Page.Resources>
    <Storyboard x:Name="Pulse" RepeatBehavior="Forever">
      <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Block"
                                     Storyboard.TargetProperty="Opacity">
        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
        <LinearDoubleKeyFrame KeyTime="0:0:0.9" Value="0.9" />
        <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.45" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </Page.Resources>

  <StackPanel Padding="32" Spacing="16" HorizontalAlignment="Left">
    <TextBlock x:Name="Status" Text="idle" />
    <Border x:Name="Block" Width="220" Height="24" CornerRadius="4" Background="Gray" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Begin" Click="OnBegin" />
      <Button Content="Stop" Click="OnStop" />
      <Button Content="Collapse block" Click="OnCollapse" />
    </StackPanel>
  </StackPanel>
</Page>
