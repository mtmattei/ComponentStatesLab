
<Page x:Class="ProductCardApp.Presentation.MainPage" Background="{ThemeResource BackgroundBrush}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:utu="using:Uno.Toolkit.UI" xmlns:mvux="using:Uno.Extensions.Reactive.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16,20,12" Background="{ThemeResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Featured Product" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource SimpleIconButtonSubtleStyle}" AutomationProperties.Name="Cart">
                <FontIcon Glyph="" FontSize="20" />
            </Button>
        </Grid>
        <mvux:FeedView Grid.Row="1" Source="{Binding Product}" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

            <DataTemplate>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <utu:CardContentControl Style="{StaticResource ElevatedCardContentControlStyle}" IsClickable="False" HorizontalAlignment="Center" Width="360" Margin="20,24">
                        <StackPanel>
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}" Height="240">
                                <Image Source="{Binding Data.ImageUrl}" Stretch="UniformToFill" AutomationProperties.Name="{Binding Data.ImageAlt}" />
                            </Border>
                            <StackPanel Padding="20,16,20,20" Spacing="8">

                                <Border Background="{ThemeResource PrimaryContainerBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Data.Brand}" Style="{StaticResource LabelSmall}" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
                                </Border>
                                <TextBlock Text="{Binding Data.Title}" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <RatingControl Value="{Binding Data.Rating}" IsReadOnly="True" MaxRating="5" FontSize="14" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}">
                                        <Run Text="{Binding Data.Rating}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding Data.ReviewCount}" />
                                        <Run Text=" reviews)" />
                                    </TextBlock>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Data.PriceDisplay}" Style="{StaticResource DisplaySmall}" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />

                                    <Button Grid.Column="1" Content="Add to Cart" Style="{StaticResource FilledButtonStyle}" Command="{Binding AddToCart}" AutomationProperties.Name="Add to cart" />
                                </Grid>
                                <!-- Brand badge -->
                                <!-- Title -->
                                <!-- Rating row -->
                                <!-- Price and CTA row -->

                            </StackPanel>
                            <!-- Product image -->
                        </StackPanel>
                    </utu:CardContentControl>
                </ScrollViewer>
            </DataTemplate>
            <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="40">
                        <ProgressRing IsActive="True" Width="56" Height="56" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Loading product…" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </mvux:FeedView.ProgressTemplate>

            <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="40" MaxWidth="320">
                        <FontIcon Glyph="" FontSize="48" Foreground="{ThemeResource OutlineBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No product available" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="Check back later for our featured picks." Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </mvux:FeedView.NoneTemplate>
            <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="40" MaxWidth="320">
                        <FontIcon Glyph="" FontSize="48" Foreground="{ThemeResource ErrorBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Something went wrong" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="We couldn&apos;t load the product. Please try again." Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="Retry" Style="{StaticResource OutlinedButtonStyle}" Command="{Binding Refresh}" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Retry loading product" />
                    </StackPanel>
                </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
            <!-- VALUE state: full product card -->
            <!-- LOADING state: centered spinner with label -->
            <!-- EMPTY (None) state: no product available -->
            <!-- ERROR state: message + retry button -->

        </mvux:FeedView>
        <!-- Header bar -->
        <!-- FeedView: handles loading / value / empty / error -->
    </Grid>
</Page>