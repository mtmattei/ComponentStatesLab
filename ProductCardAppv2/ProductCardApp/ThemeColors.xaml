<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<Color x:Key="PrimaryColor">#1A6BFF</Color>
			<Color x:Key="OnPrimaryColor">#FFFFFF</Color>
			<Color x:Key="PrimaryContainerColor">#D6E4FF</Color>
			<Color x:Key="OnPrimaryContainerColor">#001A6E</Color>
			<Color x:Key="SecondaryColor">#FF6B2B</Color>
			<Color x:Key="OnSecondaryColor">#FFFFFF</Color>
			<Color x:Key="SecondaryContainerColor">#FFE0D0</Color>
			<Color x:Key="OnSecondaryContainerColor">#3A1200</Color>
			<Color x:Key="TertiaryColor">#00A86B</Color>
			<Color x:Key="OnTertiaryColor">#FFFFFF</Color>
			<Color x:Key="TertiaryContainerColor">#BCFFE0</Color>
			<Color x:Key="OnTertiaryContainerColor">#002616</Color>
			<Color x:Key="ErrorColor">#D32F2F</Color>
			<Color x:Key="OnErrorColor">#FFFFFF</Color>
			<Color x:Key="SurfaceColor">#F5F7FF</Color>
			<Color x:Key="OnSurfaceColor">#0D1120</Color>
			<Color x:Key="SurfaceVariantColor">#E2E8FF</Color>
			<Color x:Key="OnSurfaceVariantColor">#3A4270</Color>
			<Color x:Key="BackgroundColor">#EEF1FF</Color>
			<Color x:Key="OnBackgroundColor">#0D1120</Color>
			<Color x:Key="OutlineColor">#8A96CC</Color>
			<Color x:Key="OutlineVariantColor">#C8D0F0</Color>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Default">
			<Color x:Key="PrimaryColor">#5B9BFF</Color>
			<Color x:Key="OnPrimaryColor">#002A80</Color>
			<Color x:Key="PrimaryContainerColor">#0047CC</Color>
			<Color x:Key="OnPrimaryContainerColor">#D6E4FF</Color>
			<Color x:Key="SecondaryColor">#FF8C5A</Color>
			<Color x:Key="OnSecondaryColor">#1A0900</Color>
			<Color x:Key="SecondaryContainerColor">#C94300</Color>
			<Color x:Key="OnSecondaryContainerColor">#FFE0D0</Color>
			<Color x:Key="TertiaryColor">#3DCEA0</Color>
			<Color x:Key="OnTertiaryColor">#003828</Color>
			<Color x:Key="TertiaryContainerColor">#006B45</Color>
			<Color x:Key="OnTertiaryContainerColor">#BCFFE0</Color>
			<Color x:Key="ErrorColor">#FF6B6B</Color>
			<Color x:Key="OnErrorColor">#3A0000</Color>
			<Color x:Key="SurfaceColor">#111827</Color>
			<Color x:Key="OnSurfaceColor">#E8ECFF</Color>
			<Color x:Key="SurfaceVariantColor">#1E2740</Color>
			<Color x:Key="OnSurfaceVariantColor">#9AAACF</Color>
			<Color x:Key="BackgroundColor">#090E1A</Color>
			<Color x:Key="OnBackgroundColor">#E8ECFF</Color>
			<Color x:Key="OutlineColor">#3D4F80</Color>
			<Color x:Key="OutlineVariantColor">#252F50</Color>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
