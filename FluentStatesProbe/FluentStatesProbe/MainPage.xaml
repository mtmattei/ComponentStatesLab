<Page x:Class="FluentStatesProbe.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:FluentStatesProbe.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid Padding="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Dashboard"
               Style="{StaticResource TitleTextBlockStyle}"
               Margin="0,0,0,20" />

    <!-- Recent Orders panel -->
    <Border Grid.Row="1"
            x:Name="OrdersPanel"
            VerticalAlignment="Top"
            MaxWidth="560"
            HorizontalAlignment="Left"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20,16">
      <StackPanel Spacing="12">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="Recent Orders"
                     Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Grid.Column="1"
                     Text="Last 7 days"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     VerticalAlignment="Center" />
        </Grid>

        <!-- State host: one layer visible at a time; MinHeight pins the
             populated data-region footprint so Empty/Error don't collapse it. -->
        <Grid x:Name="OrdersContent" MinHeight="275" MinWidth="274">

          <!-- Data -->
          <ItemsControl ItemsSource="{x:Bind ViewModel.Orders}"
                        Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:Order">
                <Grid Padding="0,8" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind Customer}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                      <Run Text="{x:Bind Id}" /><Run Text=" · " /><Run Text="{x:Bind PlacedOn}" />
                    </TextBlock>
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{x:Bind Status}"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Text="{x:Bind TotalDisplay}"
                             Style="{StaticResource BodyStrongTextBlockStyle}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Loading: skeleton mirroring the five populated rows -->
          <StackPanel x:Name="LoadingSkeleton"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <Grid Padding="0,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="11" VerticalAlignment="Center">
                <Border Width="126" Height="16" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Border Width="100" Height="12" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Width="54" Height="12" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              <Border Grid.Column="2" Width="64" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Grid>
            <Grid Padding="0,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="11" VerticalAlignment="Center">
                <Border Width="122" Height="16" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Border Width="96" Height="12" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Width="54" Height="12" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              <Border Grid.Column="2" Width="52" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Grid>
            <Grid Padding="0,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="11" VerticalAlignment="Center">
                <Border Width="140" Height="16" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Border Width="104" Height="12" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Width="54" Height="12" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              <Border Grid.Column="2" Width="44" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Grid>
            <Grid Padding="0,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="11" VerticalAlignment="Center">
                <Border Width="126" Height="16" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Border Width="100" Height="12" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Width="54" Height="12" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              <Border Grid.Column="2" Width="68" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Grid>
            <Grid Padding="0,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="11" VerticalAlignment="Center">
                <Border Width="130" Height="16" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                <Border Width="96" Height="12" CornerRadius="4" HorizontalAlignment="Left"
                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              </StackPanel>
              <Border Grid.Column="1" Width="54" Height="12" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
              <Border Grid.Column="2" Width="44" Height="16" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Grid>
          </StackPanel>

          <!-- Empty: successful absence, not an error -->
          <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="4">
            <TextBlock Text="No orders in the last 7 days"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="New orders will show up here."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- Error: failure + recovery -->
          <StackPanel Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE783;"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        VerticalAlignment="Center" />
              <TextBlock Text="Couldn't load recent orders"
                         Style="{StaticResource BodyTextBlockStyle}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="RetryButton"
                    Content="Retry"
                    HorizontalAlignment="Center"
                    Click="{x:Bind ViewModel.Retry}" />
          </StackPanel>

        </Grid>

      </StackPanel>
    </Border>
  </Grid>
</Page>
