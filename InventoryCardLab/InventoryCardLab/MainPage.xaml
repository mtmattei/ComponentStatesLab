<Page x:Class="InventoryCardLab.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:InventoryCardLab"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <ScrollViewer IsTabStop="True">
    <!-- Stock levels card -->
    <Border Width="420"
            Margin="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="20"
            CornerRadius="8"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <StackPanel Spacing="8">

        <!-- Card header (shared shell: identical in every state) -->
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2">
            <TextBlock Text="Stock levels"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="Warehouse A · units on hand"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  VerticalAlignment="Top"
                  Padding="6"
                  Background="Transparent"
                  BorderThickness="0"
                  AutomationProperties.Name="Refresh stock levels"
                  Command="{Binding Refresh, ElementName=StockFeed}">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
          </Button>
        </Grid>

        <!-- Data region: FeedView swaps between value / progress / none / error -->
        <mvux:FeedView x:Name="StockFeed"
                       Source="{Binding Stock}">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Data}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Padding="0,10" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Sku}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              VerticalAlignment="Center"
                              Padding="8,2"
                              CornerRadius="9"
                              Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                              Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Low"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                      </Border>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding UnitsOnHand}"
                                 Style="{StaticResource BodyStrongTextBlockStyle}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>
        </mvux:FeedView>

      </StackPanel>
    </Border>
  </ScrollViewer>
</Page>
