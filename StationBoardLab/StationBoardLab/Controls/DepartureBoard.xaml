<UserControl x:Class="StationBoardLab.Controls.DepartureBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:StationBoardLab.Models">

  <UserControl.Resources>
    <!-- Skeleton blocks reuse the board's own low-emphasis surface token. -->
    <Style x:Key="SkeletonBar" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource RailBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Resources>

  <Border Background="{StaticResource PanelBrush}"
          BorderBrush="{StaticResource PanelEdgeBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource PanelCornerRadius}"
          Padding="{StaticResource PanelPadding}">

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="BoardStates">
        <VisualState x:Name="Loading">
          <VisualState.Setters>
            <Setter Target="SkeletonLayer.Visibility" Value="Visible" />
            <Setter Target="DataLayer.Visibility" Value="Collapsed" />
            <Setter Target="EmptyLayer.Visibility" Value="Collapsed" />
            <Setter Target="ErrorLayer.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Data">
          <VisualState.Setters>
            <Setter Target="SkeletonLayer.Visibility" Value="Collapsed" />
            <Setter Target="DataLayer.Visibility" Value="Visible" />
            <Setter Target="EmptyLayer.Visibility" Value="Collapsed" />
            <Setter Target="ErrorLayer.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Empty">
          <VisualState.Setters>
            <Setter Target="SkeletonLayer.Visibility" Value="Collapsed" />
            <Setter Target="DataLayer.Visibility" Value="Collapsed" />
            <Setter Target="EmptyLayer.Visibility" Value="Visible" />
            <Setter Target="ErrorLayer.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Error">
          <VisualState.Setters>
            <Setter Target="SkeletonLayer.Visibility" Value="Collapsed" />
            <Setter Target="DataLayer.Visibility" Value="Collapsed" />
            <Setter Target="EmptyLayer.Visibility" Value="Collapsed" />
            <Setter Target="ErrorLayer.Visibility" Value="Visible" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <StackPanel Spacing="12">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Departures" Style="{StaticResource PanelTitleText}" />
          <TextBlock Text="Gare Centrale · next 60 min" Style="{StaticResource RowMetaText}" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="Refresh"
                Click="{x:Bind ViewModel.Refresh}"
                IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                VerticalAlignment="Center" />
      </Grid>

      <!-- Footprint pin: the populated data region measures 208px
           (4 rows x 52px), so every state keeps the board at 290px. -->
      <Grid x:Name="StateHost" MinHeight="208">

        <ItemsControl x:Name="DataLayer"
                      Visibility="Collapsed"
                      ItemsSource="{x:Bind ViewModel.Departures}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:Departure">
              <Grid Padding="0,7" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind ScheduledTime}"
                           Style="{StaticResource RowPrimaryText}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{x:Bind Destination}" Style="{StaticResource RowPrimaryText}" />
                  <TextBlock Style="{StaticResource RowMetaText}">
                    <Run Text="{x:Bind Line}" /><Run Text=" · " /><Run Text="{x:Bind Note}" />
                  </TextBlock>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource RailBrush}"
                        CornerRadius="4"
                        Padding="7,2"
                        VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Track}" Style="{StaticResource TrackNumberText}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Loading: same four rows, same column geometry, same 52px rhythm. -->
        <StackPanel x:Name="SkeletonLayer"
                    AutomationProperties.AccessibilityView="Raw">

          <Grid Height="52" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SkeletonBar}" Width="36" Height="14" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <Border Style="{StaticResource SkeletonBar}" Width="88" Height="14" />
              <Border Style="{StaticResource SkeletonBar}" Width="86" Height="11" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource SkeletonBar}" Width="23" Height="20" />
          </Grid>

          <Grid Height="52" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SkeletonBar}" Width="36" Height="14" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <Border Style="{StaticResource SkeletonBar}" Width="79" Height="14" />
              <Border Style="{StaticResource SkeletonBar}" Width="83" Height="11" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource SkeletonBar}" Width="23" Height="20" />
          </Grid>

          <Grid Height="52" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SkeletonBar}" Width="36" Height="14" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <Border Style="{StaticResource SkeletonBar}" Width="84" Height="14" />
              <Border Style="{StaticResource SkeletonBar}" Width="114" Height="11" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource SkeletonBar}" Width="23" Height="20" />
          </Grid>

          <Grid Height="52" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SkeletonBar}" Width="36" Height="14" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <Border Style="{StaticResource SkeletonBar}" Width="48" Height="14" />
              <Border Style="{StaticResource SkeletonBar}" Width="83" Height="11" />
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource SkeletonBar}" Width="23" Height="20" />
          </Grid>

        </StackPanel>

        <!-- Empty: a successful "nothing scheduled", not a failure. -->
        <StackPanel x:Name="EmptyLayer"
                    Visibility="Collapsed"
                    Spacing="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="No departures in the next 60 minutes."
                     Style="{StaticResource RowPrimaryText}"
                     HorizontalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="The board updates as trains are scheduled."
                     Style="{StaticResource RowMetaText}"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Error: alarm token as an accent on the headline only. -->
        <StackPanel x:Name="ErrorLayer"
                    Visibility="Collapsed"
                    Spacing="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="Couldn't load departures."
                     Style="{StaticResource RowPrimaryText}"
                     Foreground="{StaticResource AlarmBrush}"
                     HorizontalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="The station feed didn't respond."
                     Style="{StaticResource RowMetaText}"
                     HorizontalAlignment="Center" />
          <Button x:Name="RetryButton"
                  Content="Retry"
                  Click="{x:Bind ViewModel.Refresh}"
                  IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                  HorizontalAlignment="Center" />
        </StackPanel>

      </Grid>

    </StackPanel>
  </Border>
</UserControl>
