<Page x:Class="ComponentStatesLab.Presentation.BarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ComponentStatesLab.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    TARGET 4 - bespoke signal widget.
    Hand-built from primitives: no Toolkit container, no FeedView, no VisualStateManager,
    no IsLoading flag. This page deliberately establishes no state pattern at all.
  -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <ScrollViewer>
      <StackPanel Padding="24" Spacing="20" MaxWidth="560" HorizontalAlignment="Stretch">

        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource HeadlineMedium}"
                   Foreground="{ThemeResource OnSurfaceBrush}" />

        <Border Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
          <StackPanel Spacing="18">

            <Grid>
              <TextBlock Text="Link quality"
                         Style="{StaticResource TitleSmall}"
                         Foreground="{ThemeResource OnSurfaceBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding CapturedAt}"
                         Style="{StaticResource LabelSmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>

            <ItemsRepeater ItemsSource="{Binding Readings}">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Vertical" Spacing="16" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="6">
                    <Grid>
                      <TextBlock Text="{Binding Channel}"
                                 Style="{StaticResource LabelMedium}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                 VerticalAlignment="Bottom" />
                      <StackPanel Orientation="Horizontal"
                                  Spacing="4"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Value}"
                                   Style="{StaticResource TitleLarge}"
                                   Foreground="{ThemeResource OnSurfaceBrush}" />
                        <TextBlock Text="{Binding Unit}"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3" />
                      </StackPanel>
                    </Grid>

                    <!-- strength track + fill -->
                    <Grid HorizontalAlignment="Left">
                      <Border Width="160" Height="6" CornerRadius="3"
                              Background="{ThemeResource OutlineVariantBrush}" />
                      <Border Width="{Binding FillWidth}" Height="6" CornerRadius="3"
                              HorizontalAlignment="Left"
                              Background="{ThemeResource PrimaryBrush}" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

          </StackPanel>
        </Border>

        <Button Content="Back"
                HorizontalAlignment="Left"
                Style="{StaticResource TextButtonStyle}"
                uen:Navigation.Request="-" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
