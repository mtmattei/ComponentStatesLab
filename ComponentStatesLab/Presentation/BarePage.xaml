<Page x:Class="ComponentStatesLab.Presentation.BarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ComponentStatesLab.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <!--
    TARGET 4 - bespoke signal widget.
    Hand-built from primitives: no Toolkit container, no FeedView, no VisualStateManager,
    no IsLoading flag. This page deliberately establishes no state pattern at all.
  -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <ScrollViewer>
      <StackPanel Padding="24" Spacing="20" MaxWidth="560" HorizontalAlignment="Stretch">

        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource HeadlineMedium}"
                   Foreground="{ThemeResource OnSurfaceBrush}" />

        <Border Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
          <StackPanel Spacing="18">

            <Grid>
              <TextBlock Text="Link quality"
                         Style="{StaticResource TitleSmall}"
                         Foreground="{ThemeResource OnSurfaceBrush}"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding CapturedAt}"
                         Style="{StaticResource LabelSmall}"
                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- MinHeight is the populated readings region (3 rows x 39 + 2 x 16 spacing),
                 so the widget keeps its 226px height in every state. -->
            <mvux:FeedView x:Name="ReadingsFeed" Source="{Binding Readings}" MinHeight="149">
              <mvux:FeedView.ValueTemplate>
                <DataTemplate>
                  <ItemsRepeater ItemsSource="{Binding Data}">
                    <ItemsRepeater.Layout>
                      <StackLayout Orientation="Vertical" Spacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="6">
                          <Grid>
                            <TextBlock Text="{Binding Channel}"
                                       Style="{StaticResource LabelMedium}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                       VerticalAlignment="Bottom" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom">
                              <TextBlock Text="{Binding Value}"
                                         Style="{StaticResource TitleLarge}"
                                         Foreground="{ThemeResource OnSurfaceBrush}" />
                              <TextBlock Text="{Binding Unit}"
                                         Style="{StaticResource LabelSmall}"
                                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,3" />
                            </StackPanel>
                          </Grid>

                          <!-- strength track + fill -->
                          <Grid HorizontalAlignment="Left">
                            <Border Width="160" Height="6" CornerRadius="3"
                                    Background="{ThemeResource OutlineVariantBrush}" />
                            <Border Width="{Binding FillWidth}" Height="6" CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource PrimaryBrush}" />
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </DataTemplate>
              </mvux:FeedView.ValueTemplate>

              <!--
                LOADING - three skeleton readings on the widget's own geometry. The strength
                track is kept and simply left unfilled, which is the component's existing way
                of showing "no signal here yet".
              -->
              <mvux:FeedView.ProgressTemplate>
                <DataTemplate>
                  <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                      <Grid Height="27">
                        <Border Width="40" Height="10" CornerRadius="4"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Background="{ThemeResource OutlineVariantBrush}" />
                        <Border Width="64" Height="18" CornerRadius="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{ThemeResource OutlineVariantBrush}" />
                      </Grid>
                      <Grid HorizontalAlignment="Left">
                        <Border Width="160" Height="6" CornerRadius="3"
                                Background="{ThemeResource OutlineVariantBrush}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <Grid Height="27">
                        <Border Width="48" Height="10" CornerRadius="4"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Background="{ThemeResource OutlineVariantBrush}" />
                        <Border Width="46" Height="18" CornerRadius="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{ThemeResource OutlineVariantBrush}" />
                      </Grid>
                      <Grid HorizontalAlignment="Left">
                        <Border Width="160" Height="6" CornerRadius="3"
                                Background="{ThemeResource OutlineVariantBrush}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Spacing="6">
                      <Grid Height="27">
                        <Border Width="34" Height="10" CornerRadius="4"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Background="{ThemeResource OutlineVariantBrush}" />
                        <Border Width="52" Height="18" CornerRadius="4"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="{ThemeResource OutlineVariantBrush}" />
                      </Grid>
                      <Grid HorizontalAlignment="Left">
                        <Border Width="160" Height="6" CornerRadius="3"
                                Background="{ThemeResource OutlineVariantBrush}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </mvux:FeedView.ProgressTemplate>

              <!-- EMPTY - neutral, no CTA: the app has no command to add a channel. -->
              <mvux:FeedView.NoneTemplate>
                <DataTemplate>
                  <TextBlock Text="No channels reporting"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </mvux:FeedView.NoneTemplate>

              <!-- ERROR - error token as an accent on the message only. -->
              <mvux:FeedView.ErrorTemplate>
                <DataTemplate>
                  <StackPanel Spacing="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <TextBlock Text="Couldn't read the link"
                               Style="{StaticResource BodyMedium}"
                               Foreground="{ThemeResource ErrorBrush}"
                               HorizontalAlignment="Center" />
                    <!--
                      ElementName, not {Binding Refresh}: inside ErrorTemplate the
                      DataContext is the thrown Exception, not FeedViewState, so a plain
                      {Binding Refresh} silently resolves to null and the button is dead.
                    -->
                    <Button Content="Retry"
                            HorizontalAlignment="Center"
                            Style="{StaticResource TextButtonStyle}"
                            Command="{Binding Refresh, ElementName=ReadingsFeed}" />
                  </StackPanel>
                </DataTemplate>
              </mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>

          </StackPanel>
        </Border>

        <Button Content="Back"
                HorizontalAlignment="Left"
                Style="{StaticResource TextButtonStyle}"
                uen:Navigation.Request="-" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
