<Page x:Class="ComponentStatesLab.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ComponentStatesLab.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <!--
      utu:Card has fixed slots, so its states cannot be swapped inside one shared shell the
      way the holdings card's are - the Card element itself repeats per state. This style
      keeps the identity single-sourced anyway, and pins the measured populated footprint
      (332x113) so a shorter message in a slot cannot shrink the card.
    -->
    <Style x:Key="PerformanceCardStyle" TargetType="utu:Card" BasedOn="{StaticResource OutlinedCardStyle}">
      <Setter Property="MinWidth" Value="332" />
      <Setter Property="MinHeight" Value="113" />
      <!-- The Card sizes to content; inside a FeedView it would otherwise centre, moving
           it off the left edge it originally sat on. -->
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds">
    <ScrollViewer>
      <utu:AutoLayout Orientation="Vertical"
                      Spacing="20"
                      Padding="24"
                      MaxWidth="720"
                      HorizontalAlignment="Stretch"
                      CounterAxisAlignment="Stretch">

        <TextBlock Text="{Binding Title}"
                   Style="{StaticResource HeadlineMedium}"
                   Foreground="{ThemeResource OnSurfaceBrush}" />

        <!--
          ACCOUNT HEADER - the app's established state pattern.
          This widget is NOT a test target. It exists so the skill can discover that
          FeedView (with all four templates) is how this app expresses async state.
        -->
        <mvux:FeedView x:Name="AccountFeed"
                       Source="{Binding Account}"
                       utu:AutoLayout.CounterAlignment="Stretch">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <Border Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="12"
                      Padding="20">
                <utu:AutoLayout Orientation="Vertical" Spacing="4" CounterAxisAlignment="Stretch">
                  <TextBlock Text="{Binding Data.AccountName}"
                             Style="{StaticResource LabelMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  <TextBlock Text="{Binding Data.TotalValue}"
                             Style="{StaticResource HeadlineSmall}"
                             Foreground="{ThemeResource OnSurfaceBrush}" />
                  <TextBlock Text="{Binding Data.DayChange}"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource PrimaryBrush}" />
                </utu:AutoLayout>
              </Border>
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>

          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <Border Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="12"
                      Padding="20">
                <utu:AutoLayout Orientation="Vertical" Spacing="8" CounterAxisAlignment="Stretch">
                  <Border Width="120" Height="14" CornerRadius="4"
                          HorizontalAlignment="Left"
                          Background="{ThemeResource OutlineVariantBrush}" />
                  <Border Width="180" Height="28" CornerRadius="4"
                          HorizontalAlignment="Left"
                          Background="{ThemeResource OutlineVariantBrush}" />
                  <Border Width="150" Height="14" CornerRadius="4"
                          HorizontalAlignment="Left"
                          Background="{ThemeResource OutlineVariantBrush}" />
                </utu:AutoLayout>
              </Border>
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <Border Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="12"
                      Padding="20">
                <TextBlock Text="No account linked yet"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
              </Border>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <Border Background="{ThemeResource SurfaceVariantBrush}"
                      CornerRadius="12"
                      Padding="20">
                <utu:AutoLayout Orientation="Vertical" Spacing="8" CounterAxisAlignment="Stretch">
                  <TextBlock Text="Couldn't load this account"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource ErrorBrush}" />
                  <!--
                    ElementName, not {Binding Refresh}: inside ErrorTemplate the DataContext
                    is the thrown Exception, not FeedViewState, so a plain {Binding Refresh}
                    silently resolves to null and leaves a dead button.
                  -->
                  <Button Content="Retry"
                          HorizontalAlignment="Left"
                          Style="{StaticResource TextButtonStyle}"
                          Command="{Binding Refresh, ElementName=AccountFeed}" />
                </utu:AutoLayout>
              </Border>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <!--
          TARGET 1 - performance card (Uno Toolkit Card).
          The Card, its style and its 332x113 footprint are invariants; only the slot
          contents change per state.
        -->
        <mvux:FeedView x:Name="PerformanceFeed"
                       Source="{Binding Performance}"
                       utu:AutoLayout.CounterAlignment="Stretch">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <utu:Card Style="{StaticResource PerformanceCardStyle}"
                        HeaderContent="{Binding Data.Value}"
                        SubHeaderContent="{Binding Data.Label}"
                        SupportingContent="{Binding Data.Caption}" />
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>

          <!--
            LOADING - a blank card holding the pinned footprint.
            A skeleton is NOT possible here: utu:Card slots accept strings only. Assigning
            a Border to a slot is silently dropped and the presenter falls back to showing
            its DataContext, so the intended skeleton cannot be expressed with this control.
            See the note above the ErrorTemplate.
          -->
          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <utu:Card Style="{StaticResource PerformanceCardStyle}" />
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <!-- EMPTY - a dash holds the metric's place; no CTA, nothing to create here. -->
          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <utu:Card Style="{StaticResource PerformanceCardStyle}"
                        HeaderContent="&#8212;"
                        SupportingContent="No performance data yet" />
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <!--
            ERROR - message only, and deliberately degraded.
            utu:Card slots are string-only, so this state cannot carry the error-token
            accent or a Retry button the way every other component on this page does.
            An element placed in a slot is dropped and the slot renders its DataContext
            instead - in the error case that is the raw exception, stack trace and all,
            which also blew the card from 113px to 590px tall.
            Full parity here needs utu:CardContentControl; that is a control swap, so it
            is left as an open decision rather than done silently.
          -->
          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <utu:Card Style="{StaticResource PerformanceCardStyle}"
                        HeaderContent="&#8212;"
                        SupportingContent="Couldn't load performance" />
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <!--
          TARGET 2 - sector filter chips (Uno Toolkit ChipGroup).
          Populated state only. No loading, empty, or error handling.
        -->
        <utu:AutoLayout Orientation="Vertical" Spacing="8"
                        CounterAxisAlignment="Stretch"
                        utu:AutoLayout.CounterAlignment="Stretch">
          <TextBlock Text="Sectors"
                     Style="{StaticResource TitleSmall}"
                     Foreground="{ThemeResource OnSurfaceBrush}" />
          <!-- MinHeight is the populated chip row, so the section keeps its 65px height. -->
          <mvux:FeedView x:Name="SectorsFeed" Source="{Binding Sectors}" MinHeight="40">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <utu:ChipGroup ItemsSource="{Binding Data}"
                               SelectionMode="Multiple"
                               CanRemove="False"
                               Style="{StaticResource FilterChipGroupStyle}">
                  <utu:ChipGroup.ItemTemplate>
                    <DataTemplate>
                      <utu:Chip Content="{Binding Name}"
                                CanRemove="False"
                                Style="{StaticResource FilterChipStyle}" />
                    </DataTemplate>
                  </utu:ChipGroup.ItemTemplate>
                </utu:ChipGroup>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>

            <!-- LOADING - four pills on the real chip widths and 8px gaps. -->
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Width="157" Height="32" CornerRadius="16"
                          Background="{ThemeResource OutlineVariantBrush}" />
                  <Border Width="153" Height="32" CornerRadius="16"
                          Background="{ThemeResource OutlineVariantBrush}" />
                  <Border Width="127" Height="32" CornerRadius="16"
                          Background="{ThemeResource OutlineVariantBrush}" />
                  <Border Width="148" Height="32" CornerRadius="16"
                          Background="{ThemeResource OutlineVariantBrush}" />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>

            <!-- EMPTY - left aligned, matching where the chips themselves start. -->
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <TextBlock Text="No sectors to filter by"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>

            <mvux:FeedView.ErrorTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                  <TextBlock Text="Couldn't load sectors"
                             Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource ErrorBrush}"
                             VerticalAlignment="Center" />
                  <Button Content="Retry"
                          Style="{StaticResource TextButtonStyle}"
                          Command="{Binding Refresh, ElementName=SectorsFeed}" />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
        </utu:AutoLayout>

        <!--
          TARGET 3 - holdings list (ItemsRepeater inside a Toolkit CardContentControl).
          The card shell, its padding, the "Holdings" header and the 4-column row grid are
          invariants: only the data region swaps between states, through the same FeedView
          mechanism the account header above already uses.
        -->
        <utu:CardContentControl Style="{StaticResource OutlinedCardContentControlStyle}"
                                utu:AutoLayout.CounterAlignment="Stretch">
          <utu:CardContentControl.ContentTemplate>
            <DataTemplate>
              <utu:AutoLayout Orientation="Vertical"
                              Spacing="12"
                              Padding="20"
                              CounterAxisAlignment="Stretch">
                <TextBlock Text="Holdings"
                           Style="{StaticResource TitleSmall}"
                           Foreground="{ThemeResource OnSurfaceBrush}" />

                <!-- MinHeight is the populated data region (5 rows x 17 + 4 x 10 spacing),
                     so the card keeps its 196px footprint in every state. -->
                <mvux:FeedView x:Name="HoldingsFeed" Source="{Binding Holdings}" MinHeight="125">
                  <mvux:FeedView.ValueTemplate>
                    <DataTemplate>
                      <ItemsRepeater ItemsSource="{Binding Data}">
                        <ItemsRepeater.Layout>
                          <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnSpacing="12">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0"
                                         Text="{Binding Ticker}"
                                         Style="{StaticResource LabelLarge}"
                                         Foreground="{ThemeResource OnSurfaceBrush}"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Company}"
                                         Style="{StaticResource BodyMedium}"
                                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2"
                                         Text="{Binding Price}"
                                         Style="{StaticResource BodyMedium}"
                                         Foreground="{ThemeResource OnSurfaceBrush}"
                                         VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3"
                                         Text="{Binding Change}"
                                         Style="{StaticResource LabelMedium}"
                                         Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                         TextAlignment="Right"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                      </ItemsRepeater>
                    </DataTemplate>
                  </mvux:FeedView.ValueTemplate>

                  <!-- LOADING - skeleton mirroring the real row count and column positions,
                       using the same Border/CornerRadius/OutlineVariantBrush idiom as the
                       account header's ProgressTemplate. -->
                  <mvux:FeedView.ProgressTemplate>
                    <DataTemplate>
                      <utu:AutoLayout Orientation="Vertical"
                                      Spacing="10"
                                      CounterAxisAlignment="Stretch">
                        <Grid ColumnSpacing="12" Height="17">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="36" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="1" Width="90" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="2" Width="52" Height="10" CornerRadius="4"
                                  VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="3" Width="33" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12" Height="17">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="38" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="1" Width="110" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="2" Width="52" Height="10" CornerRadius="4"
                                  VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="3" Width="33" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12" Height="17">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="38" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="1" Width="98" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="2" Width="52" Height="10" CornerRadius="4"
                                  VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="3" Width="30" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12" Height="17">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="36" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="1" Width="120" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="2" Width="52" Height="10" CornerRadius="4"
                                  VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="3" Width="33" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="12" Height="17">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="64" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="31" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="1" Width="82" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="2" Width="52" Height="10" CornerRadius="4"
                                  VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                          <Border Grid.Column="3" Width="30" Height="10" CornerRadius="4"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Background="{ThemeResource OutlineVariantBrush}" />
                        </Grid>
                      </utu:AutoLayout>
                    </DataTemplate>
                  </mvux:FeedView.ProgressTemplate>

                  <!-- EMPTY - successful absence. Neutral secondary text, no CTA: the app
                       has no add-holding command to wire one to. -->
                  <mvux:FeedView.NoneTemplate>
                    <DataTemplate>
                      <TextBlock Text="No holdings yet"
                                 Style="{StaticResource BodyMedium}"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </DataTemplate>
                  </mvux:FeedView.NoneTemplate>

                  <!-- ERROR - error token as an accent on the message only; Retry is wired
                       to FeedView's own Refresh, same as the account header. -->
                  <mvux:FeedView.ErrorTemplate>
                    <DataTemplate>
                      <utu:AutoLayout Orientation="Vertical"
                                      Spacing="8"
                                      PrimaryAxisAlignment="Center"
                                      CounterAxisAlignment="Center">
                        <TextBlock Text="Couldn't load holdings"
                                   Style="{StaticResource BodyMedium}"
                                   Foreground="{ThemeResource ErrorBrush}" />
                        <Button Content="Retry"
                                Style="{StaticResource TextButtonStyle}"
                                Command="{Binding Refresh, ElementName=HoldingsFeed}" />
                      </utu:AutoLayout>
                    </DataTemplate>
                  </mvux:FeedView.ErrorTemplate>
                </mvux:FeedView>
              </utu:AutoLayout>
            </DataTemplate>
          </utu:CardContentControl.ContentTemplate>
        </utu:CardContentControl>

        <Button Content="Signal widget"
                HorizontalAlignment="Left"
                Style="{StaticResource OutlinedButtonStyle}"
                Command="{Binding GoToSignals}" />

      </utu:AutoLayout>
    </ScrollViewer>
  </Grid>
</Page>
