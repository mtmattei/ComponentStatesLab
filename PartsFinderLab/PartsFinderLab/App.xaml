<Application x:Class="PartsFinderLab.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:conv="using:PartsFinderLab.Converters">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />

      <!-- Skeleton placeholder block: same surface language as the cards it sits in. -->
      <Style x:Key="SkeletonBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
